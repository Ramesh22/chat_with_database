# Postgres connection (use a read-only role for LLM-generated queries)
DATABASE_URL=postgresql+psycopg://readonly_user:password@localhost:5432/mydb
# Local demo alternative (no server needed):
# DATABASE_URL=sqlite:///./chat_with_database.db

# --- LLM provider (any OpenAI-compatible API) ---
# OpenAI (default)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# DeepSeek example: replace the three values above with your provider's values.
# The model ID must match exactly what your provider lists.
# OPENAI_API_KEY=<your-deepseek-api-key>
# OPENAI_BASE_URL=https://api.deepseek.com
# LLM_MODEL=<exact-deepseek-model-id>
